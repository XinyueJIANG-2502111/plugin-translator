{
  "manifest_version": 3,
  "name": "Hover Translator",
  "version": "1.0",
  "description": "悬停翻译插件：支持单字与段落模式切换",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}